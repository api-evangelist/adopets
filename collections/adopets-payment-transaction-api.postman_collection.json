  "info": {
    "_postman_id": "16ab3856-6de2-4939-87ad-36b07f511a47",
    "name": "Adopets External payment-request payment-transaction API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Adopets External API for organization (shelter/rescue) integrations. It lets an external partner system connect a staff user, then create and manage adoption-related payment requests and their transactions (adoption fees, licenses, products), including retrieving, changing, cancelling requests and refunding transactions. All operations are HTTP POST with a JSON body and use an organization API key (x-api-key) plus a per-session bearer token obtained from system-auth/connect. Derived from the provider's public Postman documentation; request/response shapes reflect the published examples.\n\nContact Support:\n Name: Adopets",
      "type": "text/plain"
    }
  }
